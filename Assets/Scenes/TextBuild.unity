--- !u!114 &1758446876
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1758446874}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u81E8\u6642\u5C0F\u8003\uFF01\u6211\u7684\u771F\u540D\u662F~\uFF1F\t\u590F\u66E6\r\n\u66B1\u7A31\u5C31\u548C\u6211\u7684\u6027\u683C\u5F88\u76F8\u50CF...\tSunny\r\n\u6211\u7684\u751F\u65E5\u90A3\u9EBC\u597D\u8A18...\u4F60\u4E0D\u6703\u5FD8\u4E86\u5427\uFF1F\t1/1\r\n\u7A69\u5B9A\u53C8\u7406\u6027\u7684\u661F\u5EA7\u5594~\u4F60\u9084\u8A18\u5F97\u55CE\uFF1F\t\u6469\u7FAF\u5EA7\r\n\u9019\u500B\u4E16\u754C\u4E0A\u6700\u597D\u5403\u7684\u751C\u98DF~\u4E0D\u63A5\u53D7\u7570\u8B70\uFF0C\u4F60\u77E5\u9053\u662F\u54EA\u500B\u7684\u5427\uFF1F\t\u5DE7\u514B\u529B\r\n\u9019\u6839\u672C\u4E0D\u80FD\u7B97\u4F5C\u98DF\u7269\u5427\uFF1F\uFF1F\t\u8FA3\u6912\r\n\u8D85\u7642\u80B2\u7684~\u4F60\u731C\u731C\u770B\u6211\u525B\u525B\u5728\u5E79\u561B~\t\u6478\u5C0F\u72D7\r\n\u9019\u500B\u5468\u672B\u5F88\u9592\u6B38~\u8981\u4E0D\u8981\u4E00\u8D77...\t\u6253\u96FB\u52D5\r\n\u9806\u4FBF\u5E6B\u6211\u9EDE\u540D\u4E00\u4E0B\uFF0C\u4F60\u8A72\u4E0D\u6703\u5FD8\u8A18\u6211\u672C\u540D\u4E86\u5427?\t\u9577\u984F\u7D62\u9999\r\n\u53EA\u6709\u4F60\u53EF\u4EE5\u9019\u6A23\u53EB\u6211\u5594!\tNOA\r\n(\u3003\u2200\u3003)\u5BF6\u8C9D\u6211\u5011\u5E7E\u865F\u904E\u751F\u65E5\u554A?\t7/29\r\n\u4F60\u662F\u4E0D\u662F\u5FD8\u8A18\u6211\u7684\u661F\u5EA7\u4E86!\t\u7345\u5B50\u5EA7\r\n\u4F60\u89BA\u5F97\u86CB\u7CD5\u8981\u9078\u751A\u9EBC\u53E3\u5473\u5440~\t\u8292\u679C\r\n\u4ECA\u5929\u805A\u9910\u5168\u90FD\u662F\u6211\u4E0D\u559C\u6B61\u5403\u7684\u90A3\u500B!\t\u6D77\u9BAE\r\n\u5B89\u5B89\u525B\u5F9E\u5916\u9762\u56DE\u4F86\uFF0C\u4F60\u731C\u6211\u525B\u5728\u5E79\u561B?\t\u6162\u8DD1\r\n\u665A\u4E0A\u8981\u4E0D\u8981\u4F86\u6211\u5BB6\u4E00\u8D77...\t
    \u716E\u98EF\r\n\u79D8\uFF01\u53EA\u6709\u5C3C\u77E5\u9053\u7684\u6211\u7684\u771F\u540D\uFF01\u558A\u51FA\u4F86\u5427\uFF01\t\u611B\u6816\u6A58\r\n\u6211\u7684\u7DB2\u540D\u8D85\u7D55\u53EF\u611B\uFF01\u5C3C\u4E5F\u5FF5\u4E00\u904D\uFF01\t.\xB0\u029A
    Alice \u025E\xB0.\u2727\u02C8\u2027\u02DA\u207A\r\n\u4F60\u662F\u4E0D\u662F\u5FD8\u8A18\u6211\u7684\u751F\u65E5\u4E86\u311A(
    \uFF65\u0306\u2919\uFF65\u0306 )\t6/7\r\n\u4EBA\u5BB6\u8981\u662F\u8DD1\u5230\u5929\u4E0A\u310C\uFF0C\u5C3C\u6703\u5728\u54EA\u500B\u661F\u5EA7\u88E1\u770B\u5230\u6211\u310B\u2282(
    \u1D16 \u032B\u1D16 )\u2283\t\u96D9\u5B50\u5EA7\r\n\u5E6B\u6211\u8CB7\u6211\u6700\u559C\u6B61\u7684\u90A3\u500B\uFF01\u5167\u500B\uFF01\t\u7D05\u8C46\u9EB5\u5305\r\n\u5348\u9910\u4FBF\u7576\u4E0D\u597D\u5403\uFF01\u8A0E\u53AD\uFF01\u6211\u6700\u8A0E\u53AD\u90A3\u500B\u4E86(\u02C6\u0442
